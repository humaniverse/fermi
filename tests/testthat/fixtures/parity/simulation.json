      {"fn": "bf_fermi_simulate", "args": {"components": {"": {"ref": "point"}}, "fun": {"callback": "identity"}}, "error": "non-empty"},
      {"fn": "bf_fermi_simulate", "args": {"components": {"x": {"ref": "point"}}, "fun": {"callback": "identity"}, "n_draws": 1.5}, "error": "integer"},
      {"fn": "bf_fermi_simulate", "args": {"components": {"x": {"ref": "point"}}, "fun": {"callback": "identity"}, "n_draws": 0}, "error": "integer"},
      {"fn": "bf_fermi_simulate", "args": {"components": {"frame": {"x": []}}, "fun": {"callback": "identity"}}, "error": "n_draws"},
      {"fn": "bf_fermi_simulate", "args": {"components": {"frame": {"x": [1, 2, 3]}}, "fun": {"callback": "matrix"}}, "error": "numeric vector"},
      {"fn": "bf_fermi_simulate", "args": {"components": {"frame": {"x": [1, 2, 3]}}, "fun": {"callback": "mean"}}, "error": "one value per input row"}
    ]
  },
