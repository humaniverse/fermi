        "equals": {"draws": [5, 5, 5, 5], "inputs.x": [4, 1, 3, 2], "inputs.y": [1, 4, 2, 3], "n_dropped": 0}
      },
      {
        "fn": "bf_fermi_simulate", "args": {"components": {"frame": {"x": [4, 1, 3, 2], "y": [1, 4, 2, 3]}}, "fun": {"callback": "add"}, "n_draws": 3},
        "error": "must match the number of rows"
      },
      {
        "fn": "bf_fermi_simulate", "args": {"components": {"frame": {"x": ["a", "b"]}}, "fun": {"callback": "identity"}},
        "error": "numeric vectors"
      }
    ]
  },
  {
    "id": "simulation validates names, counts, and model output shape",
    "calls": [
