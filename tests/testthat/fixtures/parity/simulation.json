[
  {
    "id": "independent simulations can use a posterior or its attached prior",
    "calls": [
      {"fn": "bf_prior", "args": {"dist": "normal", "params": {"mean": 2, "sd": 0}}, "save": "prior"},
      {"fn": "bf_posterior", "args": {"dist": "normal", "params": {"mean": 4, "sd": 0}, "prior": {"ref": "prior"}}, "save": "post"},
      {
        "fn": "bf_fermi_simulate", "args": {"components": {"x": {"ref": "post"}, "y": {"ref": "prior"}}, "fun": {"callback": "add"}, "n_draws": 4},
        "equals": {"draws": [6, 6, 6, 6], "inputs.x": [4, 4, 4, 4], "n_dropped": 0}
      },
      {
        "fn": "bf_fermi_simulate", "args": {"components": {"x": {"ref": "post"}, "y": {"ref": "prior"}}, "fun": {"callback": "add"}, "n_draws": 4, "use": "prior"},
        "equals": {"draws": [4, 4, 4, 4]}
      },
      {"fn": "bf_posterior", "args": {"dist": "normal", "params": {"mean": 4, "sd": 0}}, "save": "unattached"},
      {
        "fn": "bf_fermi_simulate", "args": {"components": {"x": {"ref": "unattached"}}, "fun": {"callback": "identity"}, "use": "prior"},
        "error": "no attached prior"
      }
    ]
  },
  {
